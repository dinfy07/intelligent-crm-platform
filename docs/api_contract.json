      "get": {
        "summary": "List accessible filtered interactions",
        "description": "FR-04; server-side session and object authorisation required.",
        "responses": {
          "200": {
            "description": "Success where appropriate"
          },
          "401": {
            "description": "No session"
          },
          "403": {
            "description": "Forbidden without object content"
          },
          "422": {
            "description": "Invalid input"
