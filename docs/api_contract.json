{
  "openapi": "3.1.0",
  "info": {
    "title": "Intelligent CRM proposed API",
    "version": "0.1.0-design",
    "description": "Design contract only. Endpoints are not implemented."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Proposed local development server"
    }
  ],
  "paths": {
    "/sessions": {
      "post": {
        "summary": "Create authenticated session",
        "description": "FR-01; server-side session and object authorisation required.",
        "responses": {
          "200": {
            "description": "Session established"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/customers": {
      "get": {
        "summary": "List only accessible customers",
        "description": "FR-01/FR-04; server-side session and object authorisation required.",
        "responses": {
          "200": {
            "description": "Success where appropriate"
          },
          "401": {
            "description": "No session"
          },
          "403": {
            "description": "Forbidden without object content"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      },
      "post": {
        "summary": "Create customer",
        "description": "FR-02; server-side session and object authorisation required.",
        "responses": {
          "200": {
            "description": "Success where appropriate"
          },
          "401": {
            "description": "No session"
          },
          "403": {
            "description": "Forbidden without object content"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/customers/{customer_id}": {
      "get": {
        "summary": "Read customer after object-level authorisation",
        "description": "FR-01/FR-02; server-side session and object authorisation required.",
        "responses": {
          "200": {
            "description": "Success where appropriate"
          },
          "401": {
            "description": "No session"
          },
          "403": {
            "description": "Forbidden without object content"
          },
          "422": {
            "description": "Invalid input"
          }
        },
        "parameters": [
          {
            "name": "customer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      },
      "patch": {
        "summary": "Update accessible customer",
        "description": "FR-02; server-side session and object authorisation required.",
        "responses": {
          "200": {
            "description": "Success where appropriate"
          },
          "401": {
            "description": "No session"
          },
          "403": {
            "description": "Forbidden without object content"
          },
          "422": {
            "description": "Invalid input"
          }
        },
        "parameters": [
          {
            "name": "customer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
