        "description": "FR-05; server-side session and object authorisation required.",
        "responses": {
          "200": {
            "description": "Success where appropriate"
          },
          "401": {
            "description": "No session"
          },
          "403": {
            "description": "Forbidden without object content"
          },
          "422": {
            "description": "Invalid input"
          },
          "202": {
            "description": "Job accepted or existing job returned"
          }
        },
        "parameters": [
          {
            "name": "interaction_id",
            "in": "path",
